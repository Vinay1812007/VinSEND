# ---------------------------------------------------------------------------
# VinSEND environment configuration
# Copy to .env.local for development. Do not commit real values.
# ---------------------------------------------------------------------------

# Public origin the dashboard runs at (used for auth redirects, emails).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public origin the REST API is exposed at. In the MVP this is the same host.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# ---- Supabase --------------------------------------------------------------
# From: Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses RLS. Never expose in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres URL for supabase-cli migrations.
DATABASE_URL=

# ---- Secrets ---------------------------------------------------------------
# Generate with: openssl rand -base64 32
# SERVER ONLY. Rotating these invalidates all encrypted provider credentials.
SECRET_ENCRYPTION_KEY=
API_KEY_PEPPER=

# ---- Webhook dispatcher ----------------------------------------------------
WEBHOOK_USER_AGENT=VinSEND-Webhooks/1.0

# ---- Runtime ---------------------------------------------------------------
LOG_LEVEL=info
NODE_ENV=development

# ---- Optional: Upstash Redis for rate limiting -----------------------------
# When both are set, VinSEND uses Upstash instead of the Postgres adapter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Optional: Sentry ------------------------------------------------------
# When set, unhandled errors and structured warnings are also sent to Sentry.
SENTRY_DSN=
